{
  "manifest_version": 3,
  "name": "ИНН / СНИЛС генератор",
  "version": "1.3.0",
  "description": "Генерирует корректные тестовые ИНН, СНИЛС, ОГРН, БИК, банковские счета, ФИО и адреса. По желанию — автозаполнение полей на добавленных сайтах, включая свои правила и скрипты.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Сгенерировать ИНН / СНИЛС",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
